;https://www.reddit.com/r/nanDECK/comments/118x2rf/how_to_combine_two_different_decks_into_one/
INCLUDE=".\common.nde"
CARDSIZE=[card_standard_width],[card_standard_height]
LINK=".\powergrid.csv"
[fronts]=1-24
[backs]=25-48

IMAGE=[fronts],JOIN([base],"art\front\green.png"),0,0,102%,100%,,,75
IMAGE=[fronts],JOIN([base],"art\front\white.png"),0,33%,100%,35%,,,66

; Phase 2 - Power Plant Choices
FONT="DIN Engschrift Std",22,T,#000
[elektro_size]=[icon_md]
[elektro_y]=22%
[ante_y]=19.5%
[ante_off]=-4%
FONT="DIN Engschrift Std",24,T,#000
IF=[market1]<>-1
    IMAGE=[fronts],JOIN([base],"art\plant.png"),20%,8%,[icon_lg],[icon_lg],,P
    TEXT=[fronts],[market1],22.5%,10%,[icon_md],[icon_md],center,center
    IMAGE=[fronts],JOIN([base],"art\electro.png"),23%+[ante_off],[elektro_y],[elektro_size],[elektro_size],,P
    TEXT=[fronts],[ante2],32%+[ante_off],[ante_y],15%,15%,center,center
ELSE
    IMAGE=[fronts],JOIN([base],"art\plant-pass.png"),20%,8%,[icon_lg],[icon_lg],,P
ENDIF
IF=[market2]<>-1
    IMAGE=[fronts],JOIN([base],"art\plant.png"),62.5%,8%,[icon_lg],[icon_lg],,P
    TEXT=[fronts],[market2],64.5%,10%,[icon_md],[icon_md],center,center
    IMAGE=[fronts],JOIN([base],"art\electro.png"),65.5%+[ante_off],[elektro_y],[elektro_size],[elektro_size],,P
    TEXT=[fronts],[ante1],75%+[ante_off],[ante_y],15%,15%,center,center
ELSE
    IMAGE=[fronts],JOIN([base],"art\plant-pass.png"),62.5%,8%,[icon_lg],[icon_lg],,P
ENDIF

; Phase 3 - Resources
[resource_y]=44%
[plant_1_x]=20%
IF=[resource1]==2
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_1_x],[resource_y]+6%,[icon_lg],[icon_lg],,P
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_1_x],[resource_y],[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#ffffff,,0.01,0.01
    TEXT=[fronts],"1x",[plant_1_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"1x",[plant_1_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center

    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_1_x],[resource_y]-6%,[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"2x",[plant_1_x]+2.5%,[resource_y]-4%,[icon_md],[icon_md],center,center
ENDIF
IF=[resource1]==1
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_1_x],[resource_y]+6%,[icon_lg],[icon_lg],,P
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_1_x],[resource_y],[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#ffffff,,0.01,0.01
    TEXT=[fronts],"1x",[plant_1_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"1x",[plant_1_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center

    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_1_x],[resource_y]-6%,[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"1x",[plant_1_x]+2.5%,[resource_y]-4%,[icon_md],[icon_md],center,center
ENDIF
IF=[resource1]==0
    IMAGE=[fronts],JOIN([base],"art\plant-pass.png"),[plant_1_x],[resource_y],[icon_lg],[icon_lg],,P
ENDIF

[plant_2_x]=62.5%
IF=[resource2]==2
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_2_x],[resource_y]+6%,[icon_lg],[icon_lg],,P
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_2_x],[resource_y],[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#ffffff,,0.01,0.01
    TEXT=[fronts],"1x",[plant_2_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"1x",[plant_2_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center

    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_2_x],[resource_y]-6%,[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"2x",[plant_2_x]+2.5%,[resource_y]-4%,[icon_md],[icon_md],center,center
ENDIF
IF=[resource2]==1
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_2_x],[resource_y]+6%,[icon_lg],[icon_lg],,P
    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_2_x],[resource_y],[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#ffffff,,0.01,0.01
    TEXT=[fronts],"1x",[plant_2_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"1x",[plant_2_x]+2.5%,[resource_y]+7%,[icon_md],[icon_md],center,center

    IMAGE=[fronts],JOIN([base],"art\plant.png"),[plant_2_x],[resource_y]-6%,[icon_lg],[icon_lg],,P
    FONT="DIN Engschrift Std",24,T,#000
    TEXT=[fronts],"1x",[plant_2_x]+2.5%,[resource_y]-4%,[icon_md],[icon_md],center,center
ENDIF
IF=[resource2]==0
    IMAGE=[fronts],JOIN([base],"art\plant-pass.png"),[plant_2_x],[resource_y],[icon_lg],[icon_lg],,P
ENDIF

; Phase 4 - Build direction
[house_y]=80%
[build_y]=70%
[build_off]=-2%
[arrow_off]=3%

;Phase 4 - Build amount
[house_size]=[icon_md]-.1
IF=[build1]>0
    IMAGE=[fronts],JOIN([base],"art\arrow\",[compass_direction_1],".png"),20.5%+[build_off],[build_y]+1%,[icon_md],[icon_md],,P
    FONT="DIN Engschrift Std",20,T,#000,,0.015,0.015
    TEXT=[fronts],[compass_direction_1],20%+[build_off],[house_y]-1.5%,15%,[icon_md],center,center
    FONT="DIN Engschrift Std",20,T,#ffffff
    TEXT=[fronts],[compass_direction_1],20%+[build_off],[house_y]-1.5%,15%,[icon_md],center,center
    FONT="DIN Engschrift Std",20,T,#000
    TEXT=[fronts],[build1],30%+[build_off]+[arrow_off],[build_y],[icon_md],[icon_md],center,center
    IMAGE=[fronts],JOIN([base],"art\house.png"),32%+[build_off]+[arrow_off],[house_y],[house_size],[house_size],,P
ELSE
    IMAGE=[fronts],JOIN([base],"art\house-pass.png"),20%,[house_y]-6%,[icon_lg],[icon_lg],P
ENDIF


IF=[build2]>0
    IMAGE=[fronts],JOIN([base],"art\arrow\",[compass_direction_2],".png"),58%+[build_off],[build_y]+1%,[icon_md],[icon_md],,P
    FONT="DIN Engschrift Std",20,T,#000,,0.015,0.015
    TEXT=[fronts],[compass_direction_2],57.5%+[build_off],[house_y]-1.5%,15%,[icon_md],center,center
    FONT="DIN Engschrift Std",20,T,#ffffff
    TEXT=[fronts],[compass_direction_2],57.5%+[build_off],[house_y]-1.5%,15%,[icon_md],center,center
    FONT="DIN Engschrift Std",20,T,#000
    TEXT=[fronts],[build2],68%+[build_off]+[arrow_off],[build_y],[icon_md],[icon_md],center,center
    IMAGE=[fronts],JOIN([base],"art\house.png"),69.5%+[build_off]+[arrow_off],[house_y],[house_size],[house_size],,P
ELSE
    IMAGE=[fronts],JOIN([base],"art\house-pass.png"),62.5%,[house_y]-6%,[icon_lg],[icon_lg],,P
ENDIF


; CARD ID STAMP
FONT="Verdana",10,T,#777777
TEXT=[fronts],[id],36%,40%,1,1,right,center,90
FONT="Verdana",10,T,#777777
TEXT=[fronts],"v1.6",27.5%,40%,1,1,left,center,-90

LINE=[fronts],50%,10%,50%,90%,#004400,0.05

; Backs
IMAGE=[backs],JOIN([base],"art\back\best.jpeg"),0,0,100%,100%,,C
FONT="DIN Engschrift Std",40,T,#000,,0.025,0.025
TEXT=[backs],"Frida",15%,75%,50%,15%,left,center
FONT="DIN Engschrift Std",40,T,#ffffff
TEXT=[backs],"Frida",15%,75%,50%,15%,left,center

SAVE=[fronts],JOIN([base],"repo\docs\image\{§}.jpg")
SAVE=25,JOIN([base],"repo\docs\image\back.jpg")
PRINT=DUPLEX
DUPLEX=[fronts],[backs]